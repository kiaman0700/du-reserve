# 파일 제외에 대한 자세한 내용은 https://help.github.com/articles/ignoring-files/ 를 참조하세요.

# 의존성 패키지
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 테스트 결과
/coverage

# Next.js 빌드 출력물
/.next/
/out/

# 프로덕션 빌드
/build

# 기타 시스템 파일
.DS_Store
*.pem

# 디버그 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 환경 변수 설정 파일
.env*

# Vercel 설정 및 캐시
.vercel

# 타입스크립트 빌드 정보
*.tsbuildinfo
next-env.d.ts
